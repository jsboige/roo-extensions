{
  "mcpProxy": {
    "baseURL": "https://mcp-tools.myia.io",
    "addr": ":9090",
    "name": "MyIA MCP Tools",
    "version": "1.0.0",
    "type": "streamable-http",
    "options": {
      "panicIfInvalid": false,
      "logEnabled": true,
      "authTokens": ["REPLACE_WITH_TOKEN"]
    }
  },
  "mcpServers": {
    "searxng": {
      "command": "mcp-searxng",
      "args": [],
      "env": {
        "SEARXNG_URL": "https://search.myia.io/"
      }
    },
    "sk-agent": {
      "url": "http://host.docker.internal:8100/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_SK_AGENT_API_KEY"
      },
      "timeout": 900000000000
    },
    "roo-state-manager": {
      "url": "http://host.docker.internal:9091/roo-state-manager/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_HOST_PROXY_TOKEN"
      },
      "timeout": 780000000000
    }
  }
}
